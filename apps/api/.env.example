# Servidor
NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mi_centro

# Auth — generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambiar-este-secreto-en-prod
JWT_REFRESH_SECRET=cambiar-este-otro-secreto-en-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookies (Secure se activa solo en prod)
COOKIE_DOMAIN=localhost
